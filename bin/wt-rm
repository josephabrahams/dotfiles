#!/usr/bin/env bash
set -euo pipefail

# ======================================================================
# Git Worktree Remover
#
# Usage: wt-rm
# Removes current worktree. Run from a worktree, not main repo.
# ======================================================================

# Check if we're in a git repo
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "❌ Error: Not inside a git repository"
    exit 1
fi

# Check if we're in a worktree (not the main repo)
GIT_DIR="$(git rev-parse --git-dir)"
if [[ "$GIT_DIR" == ".git" ]]; then
    echo "❌ Error: Not inside a worktree (this is the main repo)"
    exit 1
fi

WORKTREE_DIR="$(git rev-parse --show-toplevel)"
BRANCH_NAME="$(git rev-parse --abbrev-ref HEAD)"
REPO_PATH="$(git rev-parse --path-format=absolute --git-common-dir)"
REPO_PATH="${REPO_PATH%/.git}"

echo "▶ Worktree:  ${WORKTREE_DIR/#$HOME/~}"
echo "▶ Branch:    $BRANCH_NAME"
echo "▶ Main repo: ${REPO_PATH/#$HOME/~}"
echo

# Confirm removal
read -p "Remove this worktree? [y/N] " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 0
fi

# Tear down Docker containers if a compose file exists
if [[ -f "$WORKTREE_DIR/docker-compose.yml" || -f "$WORKTREE_DIR/compose.yml" ]]; then
    read -p "🐳 Docker compose file found. Tear down containers and volumes? [y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        docker compose down -v
        echo "🐳 Docker containers and volumes removed"
    fi
fi

# Move out of the worktree before removing
cd "$REPO_PATH"

# Remove worktree
echo "🗑 Removing worktree..."
if ! git worktree remove "$WORKTREE_DIR" --force 2>/dev/null; then
    rm -rf "$WORKTREE_DIR"
    git worktree prune
fi

# Ask about branch deletion
read -p "Delete branch '$BRANCH_NAME'? [y/N] " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    git branch -D "$BRANCH_NAME" 2>/dev/null && echo "🗑 Branch deleted" || echo "⚠ Could not delete branch (may be merged or not exist)"
fi

echo
if [[ -n "${CURSOR_CLI:-}" || "${TERM_PROGRAM:-}" == "vscode" ]]; then
    echo "✅ Worktree removed. Close this editor window."
else
    echo "✅ Worktree removed. This directory no longer exists."
fi
