{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "WebFetch(domain:*)"
    ],
    "deny": [
      "Bash(heroku *)",
      "Bash(fly *)",
      "Bash(flyctl *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(npm exec wrangler *)",
      "Bash(aws *)",
      "Bash(az *)",
      "Bash(gcloud *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "Bash(tofu *)",
      "Bash(doctl *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh release *)",
      "Bash(gh workflow *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Read(~/.netrc)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.fly/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.wrangler/**)",
      "Read(~/Library/Preferences/.wrangler/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/private-keys-v1.d/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.*secrets*)",
      "Read(**/.envrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/agent-deny\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker *",
      "gh *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git ls-remote *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.gnupg"
      ],
      "denyRead": [
        "~/**/.env",
        "~/**/.env.local",
        "~/**/.env.*.local",
        "~/**/.env.production",
        "~/**/.env.prod",
        "~/**/.env.staging",
        "~/**/.env.*secrets*",
        "~/**/.envrc"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "~/.gnupg/S.gpg-agent",
        "~/.gnupg/S.keyboxd"
      ],
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org"
      ],
      "deniedDomains": [
        "github.com",
        "api.heroku.com",
        "git.heroku.com",
        "api.fly.io",
        "api.machines.dev",
        "api.cloudflare.com",
        "management.azure.com",
        "login.microsoftonline.com",
        "api.github.com",
        "uploads.github.com",
        "api.digitalocean.com"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.azure",
          "mode": "deny"
        },
        {
          "path": "~/.fly",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.wrangler",
          "mode": "deny"
        },
        {
          "path": "~/Library/Preferences/.wrangler",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg/private-keys-v1.d",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AZURE_CLIENT_SECRET",
          "mode": "deny"
        },
        {
          "name": "CLOUDFLARE_API_TOKEN",
          "mode": "deny"
        },
        {
          "name": "DIGITALOCEAN_ACCESS_TOKEN",
          "mode": "deny"
        },
        {
          "name": "FLY_API_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "HEROKU_API_KEY",
          "mode": "deny"
        }
      ]
    }
  }
}
