#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EXT_FILE="$DOTFILES_DIR/vscode/extensions.json"

if [[ ! -f "$EXT_FILE" ]]; then
    echo "No extensions.json found at $EXT_FILE"
    exit 1
fi

# Check for required tools
if ! command -v json5 &>/dev/null; then
    echo "Error: json5 is not installed. Install it with: brew install json5"
    exit 1
fi

if ! command -v jq &>/dev/null; then
    echo "Error: jq is not installed. Install it with: brew install jq"
    exit 1
fi

install_extensions() {
    local app_name="$1"
    local bin_path="$2"

    echo "Installing $app_name extensions..."
    if [[ -x "$bin_path" ]]; then
        json5 "$EXT_FILE" | jq -r '.recommendations[]' | while read -r ext; do
            "$bin_path" --install-extension "$ext" 2>&1 | sed -e "/Installing extensions.../d" -e "s/ Use '--force'.*//"
        done
    else
        echo "$app_name application not found. Skipping."
    fi
}

install_extensions "VS Code" "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
install_extensions "Cursor" "/Applications/Cursor.app/Contents/Resources/app/bin/code"

echo "Done."
echo ""
echo "NOTE: Prettier extension requires manually installing v11.0.2 in Cursor."
echo "      Latest versions fail with 'cannot format [filetype]-files' error."
echo "      Fix: Extensions > Prettier > Install Another Version > 11.0.2"
